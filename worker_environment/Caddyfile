{$SPARKLE_WORKER_HOSTNAME} {
    @jobs path /health /v1/jobs /v1/jobs/cancel
    reverse_proxy @jobs worker:8770
    respond 404

    request_body {
        max_size 8MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}
