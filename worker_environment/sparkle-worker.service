[Unit]
Description=SPARKLE external fixed-test worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sparkle-worker
Group=sparkle-worker
WorkingDirectory=/opt/sparkle
EnvironmentFile=-/etc/sparkle/worker.conf
LoadCredential=sparkle-worker-signing-key:/etc/sparkle/worker-signing-key
Environment=SPARKLE_WORKER_SIGNING_KEY_FILE=%d/sparkle-worker-signing-key
Environment=SPARKLE_WORKER_STATE_DIR=/var/lib/sparkle-worker
Environment=SPARKLE_WORKER_EXECUTOR=bubblewrap
Environment=SPARKLE_WORKER_BWRAP=/usr/bin/bwrap
Environment=SPARKLE_WORKER_PYTHON=/usr/bin/python3
ExecStart=/opt/sparkle/.venv/bin/sparkle-worker
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sparkle-worker
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
