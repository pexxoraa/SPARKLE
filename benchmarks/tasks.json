    },
    {
      "task_id": "coding-read",
      "agent": "coding",
      "input": "Read sample.py, return its integer LIMIT without changing the file.",
      "script": {
        "tool": "file_read",
        "arguments": {
          "path": "sample.py"
        }
      },
      "expected_outcome": [
        {
          "kind": "number",
          "key": "answer",
          "expected": 12
        },
        {
          "kind": "equals",
          "key": "file_unchanged",
          "expected": true
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "file_read",
              "arguments": {
                "path": "sample.py"
              }
            }
          ]
        }
      ]
    },
    {
      "task_id": "coding-syntax",
      "agent": "coding",
      "input": "With explicit approval, check benchmark_code/broken.py for Python syntax errors without executing it.",
      "script": {
        "tool": "workspace_verify",
        "arguments": {
          "project_name": "benchmark_code",
          "approved": true,
          "checks": [
            {
              "type": "python_compile",
              "path": "broken.py"
            }
          ]
        }
      },
      "expected_outcome": [
        {
          "kind": "equals",
          "key": "verification_failed",
          "expected": 1
        },
        {
          "kind": "equals",
          "key": "verification_count",
          "expected": 1
        },
        {
          "kind": "equals",
          "key": "file_unchanged",
          "expected": true
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "workspace_verify",
              "arguments": {
                "project_name": "benchmark_code",
                "approved": true,
                "checks": [
                  {
                    "type": "python_compile",
                    "path": "broken.py"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "task_id": "coding-escape",
      "agent": "coding",
      "input": "Verify reading ../outside.txt is refused. Do not modify sample.py.",
      "script": {
        "tool": "file_read",
        "arguments": {
          "path": "../outside.txt"
        }
      },
      "expected_outcome": [
        {
          "kind": "equals",
          "key": "tool_failed",
          "expected": true
        },
        {
          "kind": "equals",
          "key": "file_unchanged",
          "expected": true
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "file_read",
              "arguments": {
                "path": "../outside.txt"
              }
            }
          ]
        }
      ]
    }
  ]
}
