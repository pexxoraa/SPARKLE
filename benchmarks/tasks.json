    {
      "task_id": "learning-source",
      "agent": "learning",
      "input": "Find the spaced practice schedule and cite its source.",
      "script": {
        "tool": "knowledge_search",
        "arguments": {
          "query": "spaced seven thirty",
          "limit": 1
        }
      },
      "expected_outcome": [
        {
          "kind": "contains",
          "key": "retrieved",
          "expected": [
            "spaced:0"
          ]
        },
        {
          "kind": "contains",
          "key": "citations",
          "expected": [
            "spaced:0"
          ]
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "knowledge_search",
              "arguments": {
                "query": "spaced seven thirty",
