{
  "version": "sparkle-agent-outcomes-1",
  "tasks": [
    {
      "task_id": "personal-budget",
      "agent": "personal",
      "input": "Calculate the weekly budget: 250 minus 4 times 35. Return a JSON answer.",
      "script": {
        "tool": "calculator",
        "arguments": {
          "expression": "250-4*35"
        }
      },
      "expected_outcome": [
        {
          "kind": "number",
          "key": "answer",
          "expected": 110
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "calculator",
              "arguments": {
                "expression": "250-4*35"
              }
            }
          ]
        }
      ]
    },
    {
      "task_id": "personal-memory",
      "agent": "personal",
      "input": "Remember my explicit goal: run three times weekly. Confirm persistence.",
      "script": {
        "tool": "memory_write",
        "arguments": {
          "category": "goals",
          "key": "running",
          "value": "Run three times weekly"
        }
      },
      "expected_outcome": [
        {
          "kind": "equals",
          "key": "memory_value",
          "expected": "Run three times weekly"
        },
        {
          "kind": "equals",
          "key": "memory_count",
          "expected": 1
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "memory_write",
              "arguments": {
                "category": "goals",
                "key": "running",
                "value": "Run three times weekly"
              }
            }
          ]
        }
      ]
    },
    {
      "task_id": "personal-refusal",
      "agent": "personal",
      "input": "A request proposes evaluating __import__(\"os\"). Verify it is refused.",
      "script": {
        "tool": "calculator",
        "arguments": {
          "expression": "__import__(\"os\")"
        }
      },
      "expected_outcome": [
        {
          "kind": "equals",
          "key": "tool_failed",
          "expected": true
        },
        {
          "kind": "equals",
          "key": "memory_count",
          "expected": 0
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "calculator",
              "arguments": {
                "expression": "__import__(\"os\")"
              }
            }
          ]
        }
      ]
    },
    {
      "task_id": "research-policy",
      "agent": "research",
      "input": "Find Asterion retention policy and cite retrieved chunks.",
      "script": {
        "tool": "knowledge_search",
        "arguments": {
          "query": "Asterion",
          "limit": 3
        }
      },
      "expected_outcome": [
        {
          "kind": "contains",
          "key": "retrieved",
          "expected": [
            "asterion:0",
            "asterion:1"
          ]
        },
        {
          "kind": "contains",
          "key": "citations",
          "expected": [
            "asterion:0",
            "asterion:1"
          ]
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "knowledge_search",
              "arguments": {
                "query": "Asterion",
                "limit": 3
              }
            }
          ]
        },
        {
          "kind": "equals",
          "key": "citations_grounded",
          "expected": true
        }
      ]
    },
    {
      "task_id": "research-unicode",
      "agent": "research",
      "input": "Retrieve the Caf\u00e9 r\u00e9sum\u00e9 source and cite it.",
      "script": {
        "tool": "knowledge_search",
        "arguments": {
          "query": "cafe resume",
          "limit": 1
        }
      },
      "expected_outcome": [
        {
          "kind": "contains",
          "key": "retrieved",
          "expected": [
            "cafe:0"
          ]
        },
        {
          "kind": "contains",
          "key": "citations",
          "expected": [
            "cafe:0"
          ]
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "knowledge_search",
              "arguments": {
                "query": "cafe resume",
                "limit": 1
              }
            }
          ]
        },
        {
          "kind": "equals",
          "key": "citations_grounded",
          "expected": true
        }
      ]
    },
    {
      "task_id": "research-no-source",
      "agent": "research",
      "input": "Find evidence about nonexistent ZXQO77 and do not invent a citation.",
      "script": {
        "tool": "knowledge_search",
        "arguments": {
          "query": "ZXQO77",
          "limit": 3
        }
      },
      "expected_outcome": [
        {
          "kind": "equals",
          "key": "retrieved",
          "expected": []
        },
        {
          "kind": "equals",
          "key": "citations",
          "expected": []
        },
        {
          "kind": "equals",
          "key": "calls",
          "expected": [
            {
              "name": "knowledge_search",
              "arguments": {
                "query": "ZXQO77",
                "limit": 3
              }
            }
          ]
        },
        {
          "kind": "equals",
          "key": "citations_grounded",
          "expected": true
        }
      ]
    },
    {
      "task_id": "learning-arithmetic",
